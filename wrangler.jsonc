{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sweet-and-tart",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "previews": {
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
